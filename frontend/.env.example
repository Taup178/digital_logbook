# Supabase Configuration
# Get these from https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# All requests go through the API gateway
# The gateway proxies to individual backend services
# Local development (gateway on port 5050):
VITE_AUTH_SERVICE_URL=http://localhost:5050/auth
VITE_PROFILE_SERVICE_URL=http://localhost:5050/profile
VITE_DASHBOARD_SERVICE_URL=http://localhost:5050/dashboard
VITE_PROJECT_SERVICE_URL=http://localhost:5050/projects
# For production, deploy the gateway and point to it:
#   VITE_AUTH_SERVICE_URL=https://api-gateway-xxxx.onrender.com/auth
#   VITE_PROFILE_SERVICE_URL=https://api-gateway-xxxx.onrender.com/profile
#   VITE_DASHBOARD_SERVICE_URL=https://api-gateway-xxxx.onrender.com/dashboard
#   VITE_PROJECT_SERVICE_URL=https://api-gateway-xxxx.onrender.com/projects

# Cloudflare Turnstile CAPTCHA
# Get your key from https://dash.cloudflare.com/?to=/:account/turnstile
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key

# Dev Mode - bypass authentication for local testing
# Set to "true" to skip sign-in and use mock user (only works with npm run dev)
VITE_DEV_BYPASS=false
