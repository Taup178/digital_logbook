# Build stage
FROM node:18-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .

# Vite reads these at build time (they are inlined into the bundle)
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_AUTH_SERVICE_URL
ARG VITE_PROFILE_SERVICE_URL
ARG VITE_DASHBOARD_SERVICE_URL
ARG VITE_PROJECT_SERVICE_URL
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
ENV VITE_AUTH_SERVICE_URL=$VITE_AUTH_SERVICE_URL
ENV VITE_PROFILE_SERVICE_URL=$VITE_PROFILE_SERVICE_URL
ENV VITE_DASHBOARD_SERVICE_URL=$VITE_DASHBOARD_SERVICE_URL
ENV VITE_PROJECT_SERVICE_URL=$VITE_PROJECT_SERVICE_URL

RUN npm run build

# Serve stage
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
